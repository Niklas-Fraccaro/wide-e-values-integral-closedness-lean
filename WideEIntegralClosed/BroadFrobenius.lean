namespace WideEIntegralClosed

section Coefficients

variable {k K : Type*} [Field k] [Field K] [Algebra k K]
variable {ι σ : Type*} [Fintype ι]

/-- A system of linear equations with coefficients in `k` that has a solution over `K`
already has a solution over `k`. The equations may be indexed by an infinite type. -/
theorem exists_base_coefficients (a : ι → σ → k) (b : σ → k) (c : ι → K)
    (hc : ∀ s, algebraMap k K (b s) = ∑ i, algebraMap k K (a i s) * c i) :
    ∃ d : ι → k, ∀ s, b s = ∑ i, a i s * d i := by
  classical
  let j : k →ₗ[k] K := Algebra.linearMap k K
  obtain ⟨r, hr⟩ := j.exists_leftInverse_of_injective
    (LinearMap.ker_eq_bot.mpr (algebraMap k K).injective)
  have retract (x : k) : r (algebraMap k K x) = x :=
    LinearMap.congr_fun hr x
  refine ⟨fun i => r (c i), fun s => ?_⟩
  calc
    b s = r (algebraMap k K (b s)) := (retract (b s)).symm
    _ = r (∑ i, algebraMap k K (a i s) * c i) := congrArg r (hc s)
    _ = ∑ i, a i s * r (c i) := by
      rw [map_sum]
      apply Finset.sum_congr rfl
      intro i _
      rw [← Algebra.smul_def]
      simpa only [smul_eq_mul] using r.map_smul (a i s) (c i)

/-- A linear combination of vectors with base-field expansion coefficients can be written
over the base field whenever the resulting vector also has base-field coefficients. -/
theorem exists_base_coefficients_of_expansion {V : Type*} [AddCommGroup V] [Module K V]
    (expansion : V →ₗ[K] (σ → K)) (injective_expansion : Function.Injective expansion)
    (solutions : ι → V) (target : V) (a : ι → σ → k) (b : σ → k)
    (ha : ∀ i s, expansion (solutions i) s = algebraMap k K (a i s))
    (hb : ∀ s, expansion target s = algebraMap k K (b s))
    (c : ι → K) (hc : target = ∑ i, c i • solutions i) :
    ∃ d : ι → k, target = ∑ i, algebraMap k K (d i) • solutions i := by
  classical
  have hcoeff : ∀ s, algebraMap k K (b s) = ∑ i, algebraMap k K (a i s) * c i := by
    intro s
    rw [← hb s, hc, map_sum]
    simp only [Finset.sum_apply, map_smul, Pi.smul_apply, ha, smul_eq_mul, mul_comm]
  obtain ⟨d, hd⟩ := exists_base_coefficients a b c hcoeff
  refine ⟨d, injective_expansion ?_⟩
  funext s
  rw [hb, map_sum, hd s, map_sum]
  simp only [Finset.sum_apply, map_smul, Pi.smul_apply, ha, smul_eq_mul, map_mul, mul_comm]

end Coefficients

section Constants

variable {k A B : Type*} [CommRing k] [CommRing A] [CommRing B] [Algebra k A] [Algebra k B]

/-- A differential algebra embedded in an ambient algebra with no new constants has no
new constants of its own. The result applies to the field generated by a fundamental matrix
and the inverse of its determinant once it is embedded in the Laurent-log field. -/
theorem constants_of_differential_embedding (embed : A →ₐ[k] B)
    (injective_embed : Function.Injective embed) (dA : Derivation k A A) (dB : Derivation k B B)
    (commutes : ∀ a, dB (embed a) = embed (dA a))
    (constants : ∀ b, dB b = 0 → ∃ c : k, algebraMap k B c = b) (a : A) :
    dA a = 0 ↔ ∃ c : k, algebraMap k A c = a := by
  constructor
  · intro h
    obtain ⟨c, hc⟩ := constants (embed a) (by rw [commutes, h, map_zero])
    exact ⟨c, injective_embed ((embed.commutes c).trans hc)⟩
  · rintro ⟨c, rfl⟩
    exact dA.map_algebraMap c

end Constants

section Frames

open StrictEUnit

local notation "k₀" => IntermediateField.toSubfield (algebraicClosure ℚ ℂ)
local notation "A₀" => subfieldEntireFunctionAlgebra k₀
local notation "B₀" => LaurentLogBase k₀
local notation "L₀" => RatFunc (LaurentSeries k₀)

attribute [local instance] StrictEUnit.formalAmbientBaseAlgebra
attribute [local instance] StrictEUnit.formalAmbientBaseTower

variable {n : Type} [Fintype n] [DecidableEq n]

/-- The actual Euler frame whose existence is the broad Frobenius input. The residue may
be any algebraic matrix with rational spectrum, since the logarithmic factor can be built
by changing the basis over the algebraic numbers. -/
structure BroadArithmeticFrame (n : Type) [Fintype n] [DecidableEq n] where
  system : Matrix n n (LaurentPolynomial k₀)
  residue : Matrix n n k₀
  amplitudes : Matrix n n A₀
  broad : ∀ i j, WideE.IsWideEFunction (amplitudes i j).val.val
  rational_spectrum : ∀ a : k₀, (minpoly k₀ residue).IsRoot a → ∃ q : ℚ, (q : k₀) = a
  frame_equation : Stage17ActualEulerFrameRelation k₀ system residue amplitudes
  invertible_at_one : (amplitudes.map (stage14_subfieldEntireEvaluation k₀ 1)).det ≠ 0

/-- The broad arithmetic existence statement for finite lists of original functions.
Clearing the Laurent poles of a Frobenius frame in Section 1 gives entire amplitudes and
shifts the residue matrix by an integer scalar. The original functions are entries of
arithmetic solution matrices, with their identities as actual functions retained. -/
def BroadArithmeticFrameExistence : Prop :=
  ∀ {ι : Type} [Finite ι] (f : ι → ℂ → ℂ), (∀ i, WideE.IsWideEFunction (f i)) →
    ∃ d : ℕ, ∃ frame : BroadArithmeticFrame (Fin d), ∃ solutions : Matrix (Fin d) (Fin d) A₀,
      Stage17ActualEulerFrameRelation k₀ frame.system 0 solutions ∧
      ∀ i, ∃ r c : Fin d, (solutions r c).val.val = f i

/-- A formal fundamental matrix and base-field coordinates of specified arithmetic solutions.
The entries are genuine ramified Taylor series, multiplied by a Laurent-log matrix unit. -/
structure RamifiedFundamental (frame : BroadArithmeticFrame n) (solutions : Matrix n n A₀) where
  degree : ℕ
  positive : degree ≠ 0
  factor : (Matrix n n B₀)ˣ
  normalized : (laurentLogBasePoint k₀).toRingHom.mapMatrix (factor : Matrix n n B₀) = 1
  invertible : IsUnit (stage17_formalFundamental k₀ degree positive frame.amplitudes factor)
  equation : matrixDerivative (formalAmbientDerivation degree positive)
      (stage17_formalFundamental k₀ degree positive frame.amplitudes factor) =
    (frame.system.map (stage17_laurentBasePullback k₀ degree)).map formalBaseEmbedding *
      stage17_formalFundamental k₀ degree positive frame.amplitudes factor
  coordinates : Matrix n n k₀
  represents : stage17_formalFrame k₀ degree positive solutions =
    stage17_formalFundamental k₀ degree positive frame.amplitudes factor *
      coordinates.map (algebraMap k₀ L₀)

/-- An actual broad arithmetic frame produces the formal PV matrix and places all the
specified arithmetic solutions in its span over the original coefficient field. -/
theorem BroadArithmeticFrame.exists_ramifiedFundamental (frame : BroadArithmeticFrame n)
    (solutions : Matrix n n A₀)
    (hsolutions : Stage17ActualEulerFrameRelation k₀ frame.system 0 solutions) :
    Nonempty (RamifiedFundamental frame solutions) := by
  letI : IsAlgClosed k₀ := stage17_algebraicTaylorField_isAlgClosed
  obtain ⟨N, hN, Z, hZ, hpoint, hunit, hode⟩ :=
    stage17_actualFrame_exists_formalFundamental k₀ frame.system frame.residue frame.amplitudes
      frame.rational_spectrum frame.frame_equation frame.invertible_at_one
  obtain ⟨C, hC⟩ := stage21_actualSolutionMatrix_has_arithmetic_coordinates k₀ N hN
    frame.system frame.residue frame.amplitudes solutions frame.frame_equation hsolutions
    frame.invertible_at_one Z hZ
  exact ⟨⟨N, hN, Z, hpoint, hunit, hode, C, hC⟩⟩

namespace RamifiedFundamental

variable {frame : BroadArithmeticFrame n} {solutions : Matrix n n A₀}

/-- The formal Picard–Vessiot candidate over the Laurent-log base. -/
def candidate (F : RamifiedFundamental frame solutions) : Subalgebra B₀ L₀ :=
  matrixGeneratedAlgebra (stage17_formalFundamental k₀ F.degree F.positive frame.amplitudes F.factor)

/-- The same algebra is generated by the arithmetic amplitudes over the enlarged base.
The logarithmic factor is invertible over that base. -/
theorem candidate_eq_amplitudes (F : RamifiedFundamental frame solutions) :
    F.candidate = matrixGeneratedAlgebra (stage17_formalFrame k₀ F.degree F.positive frame.amplitudes) := by
  change matrixGeneratedAlgebra (B := B₀)
      (stage17_formalFrame k₀ F.degree F.positive frame.amplitudes *
        (F.factor : Matrix n n B₀).map (algebraMap B₀ L₀)) = _
  exact matrixGeneratedAlgebra_mul_base_unit _ _

/-- The specified original solutions belong to the common candidate algebra. -/
theorem solution_mem_candidate (F : RamifiedFundamental frame solutions) (i j : n) :
    stage17_formalFrame k₀ F.degree F.positive solutions i j ∈ F.candidate := by
  let Y := stage17_formalFundamental k₀ F.degree F.positive frame.amplitudes F.factor
  rw [F.represents, Matrix.mul_apply]
  apply Subalgebra.sum_mem
  intro l _
  apply F.candidate.mul_mem
  · exact matrixEntryAlgebra_le Y (matrixEntry_mem Y i l)
  · change algebraMap k₀ L₀ (F.coordinates l j) ∈ F.candidate
    rw [IsScalarTower.algebraMap_apply k₀ B₀ L₀]
    exact F.candidate.algebraMap_mem _

private theorem pullback_bound (N : ℕ) {f : ℂ → ℂ} (hf : WideE.IsWideEFunction f) :
    HasPowerExponentialBound (N * 2) (fun z => f (z ^ N)) := by
  obtain ⟨C, hC, bound⟩ := hf.quadratic_exp_bound
  refine powerExponentialBound_of_separate_constants (N * 2) 0 id _ C 1 hC (by norm_num) ?_
  intro z _
  simpa only [id_eq, pow_zero, mul_one, one_mul, norm_pow, pow_mul] using bound (z ^ N)

/-- The actual amplitudes after ramification, with a power-exponential bound of degree twice
the ramification degree. -/
def boundedFrame (F : RamifiedFundamental frame solutions) :
    Matrix n n (stage18_boundedArithmeticEntireAlgebra k₀ (F.degree * 2)) :=
  fun i j => stage18_boundArithmeticFunction k₀ (F.degree * 2)
    (stage17_arithmeticPowerPullback k₀ F.degree F.positive (frame.amplitudes i j))
    (pullback_bound F.degree (frame.broad i j))

theorem boundedFrame_det_apply (F : RamifiedFundamental frame solutions) (z : ℂ) :
    F.boundedFrame.det.val z =
      (frame.amplitudes.map (stage14_subfieldEntireEvaluation k₀ (z ^ F.degree))).det := by
  let e : stage18_boundedArithmeticEntireAlgebra k₀ (F.degree * 2) →ₐ[k₀] ℂ :=
    (stage14_subfieldEntireEvaluation k₀ z).comp (stage18_boundedToArithmeticAlgHom k₀ (F.degree * 2))
  change e.toRingHom F.boundedFrame.det = _
  rw [RingHom.map_det]
  rfl

theorem boundedFrame_det_nonzero (F : RamifiedFundamental frame solutions) :
    ∀ z : ℂ, z ≠ 0 → F.boundedFrame.det.val z ≠ 0 := by
  intro z hz
  rw [F.boundedFrame_det_apply]
  exact stage23_arithmeticFrame_det_nonzero_off_origin k₀ frame.system frame.residue
    frame.amplitudes frame.frame_equation frame.invertible_at_one (z ^ F.degree) (pow_ne_zero _ hz)

/-- Evaluation of the formal candidate at the genuine ordinary point.
The coefficient evaluation is analytic and the formal logarithm maps to zero. -/
def evaluateAtOne (F : RamifiedFundamental frame solutions) : F.candidate →ₐ[k₀] ℂ :=
  formalMatrixCandidateEvaluation (stage19_formalMatrix k₀ (F.degree * 2) F.boundedFrame) F.factor
    (stage19_generatedEvaluation k₀ (F.degree * 2) F.boundedFrame F.boundedFrame_det_nonzero
      ⟨1, one_ne_zero⟩)

/-- An entry of the formal amplitude matrix as an element of the candidate. -/
def amplitudeInCandidate (F : RamifiedFundamental frame solutions) (i j : n) : F.candidate :=
  ⟨stage17_formalFrame k₀ F.degree F.positive frame.amplitudes i j, by
    rw [F.candidate_eq_amplitudes]
    exact matrixEntryAlgebra_le _ (matrixEntry_mem _ i j)⟩

@[simp] theorem evaluateAtOne_amplitude (F : RamifiedFundamental frame solutions) (i j : n) :
    F.evaluateAtOne (F.amplitudeInCandidate i j) = (frame.amplitudes i j).val.val 1 := by
  let G := F.boundedFrame
  let ν := stage19_generatedEvaluation k₀ (F.degree * 2) G F.boundedFrame_det_nonzero
    ⟨1, one_ne_zero⟩
  let e := stage19_generatedEntry k₀ (F.degree * 2) G i j
  calc
    _ = ν e := formalMatrixCandidateEvaluation_coefficient _ _ ν _ e rfl
    _ = (G i j).val 1 := stage19_generatedEvaluation_entry k₀ (F.degree * 2) G
      F.boundedFrame_det_nonzero i j ⟨1, one_ne_zero⟩
    _ = _ := by
      change (frame.amplitudes i j).val.val (1 ^ F.degree) = _
      rw [one_pow]

/-- The inverse of the formal amplitude determinant as an element of the candidate. -/
def amplitudeDeterminantInverse (F : RamifiedFundamental frame solutions) : F.candidate :=
  ⟨(stage17_formalFrame k₀ F.degree F.positive frame.amplitudes).det⁻¹, by
    rw [F.candidate_eq_amplitudes]
    exact (matrixGeneratedAlgebra_le_iff _ _).mp le_rfl |>.1⟩

@[simp] theorem evaluateAtOne_determinantInverse (F : RamifiedFundamental frame solutions) :
    F.evaluateAtOne F.amplitudeDeterminantInverse =
      (frame.amplitudes.map (stage14_subfieldEntireEvaluation k₀ 1)).det⁻¹ := by
  let G := F.boundedFrame
  let ν := stage19_generatedEvaluation k₀ (F.degree * 2) G F.boundedFrame_det_nonzero
    ⟨1, one_ne_zero⟩
  let e := stage19_generatedDeterminantInverse k₀ (F.degree * 2) G
  have hcoeff : (F.amplitudeDeterminantInverse : L₀) = RatFunc.C (e : LaurentSeries k₀) := by
    change ((stage19_formalMatrix k₀ (F.degree * 2) G).map RatFunc.C).det⁻¹ =
      RatFunc.C ((stage19_formalMatrix k₀ (F.degree * 2) G).det⁻¹)
    calc
      _ = (RatFunc.C (stage19_formalMatrix k₀ (F.degree * 2) G).det)⁻¹ :=
        congrArg Inv.inv ((RatFunc.C : LaurentSeries k₀ →+* L₀).map_det
          (stage19_formalMatrix k₀ (F.degree * 2) G)).symm
      _ = _ := (map_inv₀ RatFunc.C _).symm
  calc
    _ = ν e := formalMatrixCandidateEvaluation_coefficient _ _ ν _ e hcoeff
    _ = (G.det.val 1)⁻¹ := stage19_generatedEvaluation_determinantInverse k₀ (F.degree * 2) G
      F.boundedFrame_det_nonzero ⟨1, one_ne_zero⟩
    _ = _ := by
      change (F.boundedFrame.det.val 1)⁻¹ = _
      rw [F.boundedFrame_det_apply, one_pow]

private theorem evaluateAtOne_base_C (F : RamifiedFundamental frame solutions)
    (p : LaurentPolynomial k₀) :
    F.evaluateAtOne (algebraMap B₀ F.candidate (Polynomial.C p)) =
      stage19_generatedEvaluation k₀ (F.degree * 2) F.boundedFrame F.boundedFrame_det_nonzero
        ⟨1, one_ne_zero⟩ (stage19_generatedLaurentPolynomial k₀ (F.degree * 2) F.boundedFrame p) := by
  apply formalMatrixCandidateEvaluation_coefficient
  change (algebraMap (Polynomial (LaurentSeries k₀)) L₀)
    ((Polynomial.C p).map laurentPolynomialToSeries.toRingHom) =
      RatFunc.C (laurentPolynomialToSeries p)
  rw [Polynomial.map_C, RatFunc.algebraMap_C]
  rfl

private theorem evaluateAtOne_base_X (F : RamifiedFundamental frame solutions) :
    F.evaluateAtOne (algebraMap B₀ F.candidate Polynomial.X) = 0 := by
  apply formalMatrixCandidateEvaluation_log
  change (algebraMap (Polynomial (LaurentSeries k₀)) L₀)
    ((Polynomial.X : B₀).map laurentPolynomialToSeries.toRingHom) = RatFunc.X
  rw [Polynomial.map_X, RatFunc.algebraMap_X]

/-- Evaluation on the candidate restricts to the point `(1, 0)` on the Laurent-log base. -/
theorem evaluateAtOne_base (F : RamifiedFundamental frame solutions) (p : B₀) :
    F.evaluateAtOne (algebraMap B₀ F.candidate p) = (laurentLogBasePoint k₀ p : ℂ) := by
  let φ : B₀ →ₐ[k₀] ℂ := F.evaluateAtOne.comp (IsScalarTower.toAlgHom k₀ B₀ F.candidate)
  let ψ : B₀ →ₐ[k₀] ℂ := (Algebra.ofId k₀ ℂ).comp (laurentLogBasePoint k₀)
  let φC : LaurentPolynomial k₀ →+* ℂ := φ.toRingHom.comp Polynomial.C
  let ψC : LaurentPolynomial k₀ →+* ℂ := ψ.toRingHom.comp Polynomial.C
  have hpos : φC (LaurentPolynomial.T 1) = ψC (LaurentPolynomial.T 1) := by
    change F.evaluateAtOne (algebraMap B₀ F.candidate (Polynomial.C (LaurentPolynomial.T 1))) =
      (laurentLogBasePoint k₀ (Polynomial.C (LaurentPolynomial.T 1)) : ℂ)
    rw [F.evaluateAtOne_base_C, stage19_generatedEvaluation_coordinate]
    simpa only [LaurentPolynomial.T, laurentLogBasePoint_monomial] using
      (show (1 : ℂ) = ((1 : k₀) : ℂ) from rfl)
  have hneg : φC (LaurentPolynomial.T (-1)) = ψC (LaurentPolynomial.T (-1)) := by
    change F.evaluateAtOne (algebraMap B₀ F.candidate (Polynomial.C (LaurentPolynomial.T (-1)))) =
      (laurentLogBasePoint k₀ (Polynomial.C (LaurentPolynomial.T (-1))) : ℂ)
    rw [F.evaluateAtOne_base_C, stage19_generatedEvaluation_coordinate_inverse]
    simpa only [LaurentPolynomial.T, laurentLogBasePoint_monomial, inv_one] using
      (show (1 : ℂ) = ((1 : k₀) : ℂ) from rfl)
  have hC (q : LaurentPolynomial k₀) : φC q = ψC q := by
    induction q using LaurentPolynomial.induction_on with
    | h_C a => exact (φ.commutes a).trans (ψ.commutes a).symm
    | h_add hp hq => simp only [map_add, hp, hq]
    | h_C_mul_T n a ih =>
      rw [LaurentPolynomial.T_add, ← mul_assoc, map_mul φC, map_mul ψC, ih, hpos]
    | h_C_mul_T_Z n a ih =>
      rw [sub_eq_add_neg, LaurentPolynomial.T_add, ← mul_assoc, map_mul φC, map_mul ψC, ih, hneg]
  have hX : φ Polynomial.X = ψ Polynomial.X := by
    change F.evaluateAtOne (algebraMap B₀ F.candidate Polynomial.X) =
      (laurentLogBasePoint k₀ Polynomial.X : ℂ)
    simp only [F.evaluateAtOne_base_X, laurentLogBasePoint_X, Subfield.coe_zero]
  exact DFunLike.congr_fun (Polynomial.ringHom_ext hC hX) p

/-- A fundamental-matrix entry as an element of the candidate. -/
def fundamentalInCandidate (F : RamifiedFundamental frame solutions) (i j : n) : F.candidate :=
  ⟨stage17_formalFundamental k₀ F.degree F.positive frame.amplitudes F.factor i j,
    matrixEntryAlgebra_le _ (matrixEntry_mem _ i j)⟩

@[simp] theorem evaluateAtOne_fundamental (F : RamifiedFundamental frame solutions) (i j : n) :
    F.evaluateAtOne (F.fundamentalInCandidate i j) = (frame.amplitudes i j).val.val 1 := by
  classical
  have heq : F.fundamentalInCandidate i j = ∑ l,
      F.amplitudeInCandidate i l * algebraMap B₀ F.candidate (F.factor.val l j) := by
    apply Subtype.ext
    change stage17_formalFundamental k₀ F.degree F.positive frame.amplitudes F.factor i j =
      F.candidate.val (∑ l, F.amplitudeInCandidate i l *
        algebraMap B₀ F.candidate (F.factor.val l j))
    rw [map_sum, stage17_formalFundamental, Matrix.mul_apply]
    apply Finset.sum_congr rfl
    intro l _
    rfl
  have hpoint (l : n) : (laurentLogBasePoint k₀ (F.factor.val l j) : ℂ) =
      if l = j then 1 else 0 := by
    have h := congrArg (fun Z : Matrix n n k₀ => Z l j) F.normalized
    simpa [Matrix.one_apply, apply_ite] using congrArg (fun x : k₀ => (x : ℂ)) h
  rw [heq, map_sum]
  simp only [map_mul, evaluateAtOne_amplitude, evaluateAtOne_base, hpoint,
    mul_ite, mul_one, mul_zero, Finset.sum_ite_eq', Finset.mem_univ, ite_true]

/-- The formal series of an original solution as an element of the candidate. -/
def solutionInCandidate (F : RamifiedFundamental frame solutions) (i j : n) : F.candidate :=
  ⟨stage17_formalFrame k₀ F.degree F.positive solutions i j, F.solution_mem_candidate i j⟩

/-- Evaluation agrees with the value at one of every original arithmetic solution. -/
@[simp] theorem evaluateAtOne_solution (F : RamifiedFundamental frame solutions) (i j : n) :
    F.evaluateAtOne (F.solutionInCandidate i j) = (solutions i j).val.val 1 := by
  classical
  have heq : F.solutionInCandidate i j = ∑ l,
      F.fundamentalInCandidate i l * algebraMap k₀ F.candidate (F.coordinates l j) := by
    apply Subtype.ext
    change stage17_formalFrame k₀ F.degree F.positive solutions i j =
      F.candidate.val (∑ l, F.fundamentalInCandidate i l *
        algebraMap k₀ F.candidate (F.coordinates l j))
    rw [map_sum, F.represents, Matrix.mul_apply]
    apply Finset.sum_congr rfl
    intro l _
    rfl
  have hvalue := congrArg (fun V : Matrix n n ℂ => V i j)
    (stage21_formal_connection_implies_actual_value k₀ F.degree F.positive
      frame.amplitudes solutions F.factor F.coordinates F.normalized F.represents)
  rw [heq, map_sum]
  simp only [map_mul, evaluateAtOne_fundamental, AlgHom.commutes]
  simpa only [Matrix.mul_apply, Matrix.map_apply] using hvalue.symm

end RamifiedFundamental

